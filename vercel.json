{
  "version": 2,
  "name": "bro-biryani",
  "routes": [
    {
      "src": "/styles.css",
      "dest": "/styles.css",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/app.js",
      "dest": "/app.js",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
